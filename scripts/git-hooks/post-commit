#!/usr/bin/env bash
# Git post-commit hook for sandwich-engine
# Appends structured commit telemetry to .git/JOURNAL.jsonl
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
JOURNAL="$REPO_ROOT/.git/JOURNAL.jsonl"

SHA="$(git -C "$REPO_ROOT" rev-parse HEAD)"
DATE="$(git -C "$REPO_ROOT" log -1 --format=%aI)"
SUBJECT="$(git -C "$REPO_ROOT" log -1 --format=%s)"
DIFFSTAT="$(git -C "$REPO_ROOT" log -1 --stat | tail -n 1 | sed 's/^[ \t]*//')"

KERNEL="$(uname -r)"
DRIVER="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null || echo 'none')"
GOVERNOR="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'unknown')"

python3 -c "
import json, sys
entry = {
    'sha': sys.argv[1],
    'date': sys.argv[2],
    'subject': sys.argv[3],
    'diffstat': sys.argv[4],
    'environment': {
        'kernel': sys.argv[5],
        'driver': sys.argv[6],
        'governor': sys.argv[7]
    }
}
with open(sys.argv[8], 'a', encoding='utf-8') as f:
    f.write(json.dumps(entry) + '\n')
" "$SHA" "$DATE" "$SUBJECT" "$DIFFSTAT" "$KERNEL" "$DRIVER" "$GOVERNOR" "$JOURNAL"
